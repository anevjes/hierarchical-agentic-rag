# Copy to .env. Authenticate locally with `az login`; no keys or SAS URLs are needed.
HRAG_STORAGE_ACCOUNT_URL=https://YOUR-STORAGE.blob.core.windows.net
HRAG_SOURCE_CONTAINER=documents
HRAG_PAGES_CONTAINER=document-pages
HRAG_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
HRAG_INDEX_NAME=page-chunks
HRAG_KNOWLEDGE_SOURCE_NAME=page-chunks-source
HRAG_KNOWLEDGE_BASE_NAME=document-investigation
HRAG_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-DI.cognitiveservices.azure.com
HRAG_FOUNDRY_PROJECT_ENDPOINT=https://YOUR-FOUNDRY.services.ai.azure.com/api/projects/YOUR-PROJECT
# A deployed model that supports Responses, function calling, and structured outputs.
# GPT-4.1 is a suitable starting point; supply YOUR deployment name.
HRAG_MODEL_DEPLOYMENT=gpt-4.1

HRAG_MAX_TOOL_CALLS=20
HRAG_MAX_SEARCHES=4
HRAG_MAX_HITS=8
HRAG_MAX_PAGES=24
HRAG_MAX_CONTEXT_CHARS=100000
HRAG_QUERY_TIMEOUT_SECONDS=180
