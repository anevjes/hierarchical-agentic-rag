# Copy to .env. Authenticate locally with `az login`; no keys or SAS URLs are needed.
HRAG_STORAGE_ACCOUNT_URL=https://YOUR-STORAGE.blob.core.windows.net
HRAG_SOURCE_CONTAINER=documents
HRAG_PAGES_CONTAINER=document-pages
HRAG_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
HRAG_INDEX_NAME=page-chunks
HRAG_KNOWLEDGE_SOURCE_NAME=page-chunks-source
HRAG_KNOWLEDGE_BASE_NAME=document-investigation
HRAG_CONTENT_UNDERSTANDING_ENDPOINT=https://YOUR-FOUNDRY.services.ai.azure.com
HRAG_CONTENT_UNDERSTANDING_ANALYZER=prebuilt-documentSearch
# Optional request-scoped mappings; otherwise the resource defaults must resolve the analyzer.
# Use the model keys from get_analyzer().models and YOUR deployment names.
# HRAG_CONTENT_UNDERSTANDING_MODEL_DEPLOYMENTS={"prebuilt-analyzer-completion-mini":"gpt-5","prebuilt-analyzer-embedding":"text-embedding-3-large"}
HRAG_CONTENT_UNDERSTANDING_PROCESSING_LOCATION=geography
HRAG_FOUNDRY_PROJECT_ENDPOINT=https://YOUR-FOUNDRY.services.ai.azure.com/api/projects/YOUR-PROJECT
# A deployed model that supports Responses, function calling, and structured outputs.
# GPT-4.1 is a suitable starting point; supply YOUR deployment name.
HRAG_MODEL_DEPLOYMENT=gpt-4.1
# The SAME deployment/model/dimensions are used for chunk and query embeddings.
# Query vectorization uses the Search service's system-assigned managed identity.
HRAG_EMBEDDING_ENDPOINT=https://YOUR-FOUNDRY.openai.azure.com
HRAG_EMBEDDING_DEPLOYMENT=text-embedding-3-large
HRAG_EMBEDDING_MODEL=text-embedding-3-large
HRAG_EMBEDDING_DIMENSIONS=3072

# Optional USD per million tokens, keyed by ACTUAL deployment name.
# No default prices: supply your contracted rates, not these illustrative placeholders.
# HRAG_TOKEN_RATES_USD_PER_MILLION={"my-chat":{"input":1.0,"output":4.0,"cached_input":0.25},"my-embedding":{"input":0.1,"output":0}}

HRAG_MAX_TOOL_CALLS=20
HRAG_MAX_SEARCHES=4
HRAG_MAX_HITS=8
HRAG_MAX_PAGES=24
HRAG_MAX_CONTEXT_CHARS=100000
HRAG_QUERY_TIMEOUT_SECONDS=180

# Optional cross-document workflow: provision --catalog, catalog, then ask --broad.
HRAG_CATALOG_INDEX_NAME=document-catalog
HRAG_BROAD_MAX_DOCUMENTS=6
HRAG_BROAD_CONCURRENCY=3
HRAG_BROAD_MAX_FACETS=4
HRAG_BROAD_CANDIDATES_PER_QUERY=20
HRAG_BROAD_MAX_TOOL_CALLS=60
HRAG_BROAD_MAX_SEARCHES=24
HRAG_BROAD_MAX_PAGES=48
HRAG_BROAD_MAX_CONTEXT_CHARS=150000
HRAG_BROAD_TIMEOUT_SECONDS=300
HRAG_BROAD_MAX_EVIDENCE_RECORDS=8
HRAG_BROAD_QUOTE_CHARS=1200
